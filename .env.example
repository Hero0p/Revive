# Razorpay test mode. Dashboard -> Settings -> API Keys.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# Dashboard -> Settings -> Webhooks. This is NOT the key secret.
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# Signs the /orders/{id}/resume tokens. Any random string.
RESUME_TOKEN_SECRET=change-me

# Optional. Writes the message body only -- never a decision about money.
# Without it the system uses hand-written templates, which is a supported mode.
# Free key from https://console.groq.com/keys
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
# Reasoning models spend their whole token budget thinking unless this is set.
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_SECONDS=2.0

# Public base URL used in message links (tunnel URL during the demo).
PUBLIC_BASE_URL=http://localhost:5173

# --- Real delivery (email only) ------------------------------------------
# With this on, advancing the clock sends real email. Synthetic comparison
# runs never deliver, whatever this is set to.
DELIVER_FOR_REAL=false
# Strongly recommended while demoing: only these recipients can be contacted.
DELIVERY_ALLOWLIST=

# The gate's per-customer contact cap, in hours. 24 is the product default and
# what every published result uses. Every live test checkout shares one phone
# number, so they are all one customer and each one after the first is
# correctly deferred a full day -- set this to 0 to demo back-to-back
# checkouts, and leave it alone for anything you intend to quote.
MIN_HOURS_BETWEEN_CONTACTS=24
# Gmail: enable 2-step verification, then create an App Password at
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM_NAME=Blue Tokai Coffee
